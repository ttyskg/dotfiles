#!/bin/bash
#
# Create a .devcontainer directory for VS Code in the current directory.
#
#   .devcontainer
#    |- devcontainer.json
#    |- docker-compose.yml
#    |- Dockerfile
#    |_ requirements.txt

set -eu

FORCE=false

show_help() {
  echo "Usage: $(basename "$0") [--force]"
  echo
  echo "  --force   Overwrite an existing .devcontainer directory"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --force)
      FORCE=true
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      show_help
      exit 1
      ;;
  esac
  shift
done

if [ -e .devcontainer ] && [ "$FORCE" = false ]; then
  echo ".devcontainer already exists. Use --force to overwrite." >&2
  exit 1
fi

echo "Making .devcontainer directory..."
mkdir -p .devcontainer

echo "  devcontainer.json"
cat > .devcontainer/devcontainer.json <<'EOF'
{
    "name": "python-dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/tmp/work",
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "DavidAnson.vscode-markdownlint",
                "eamodio.gitlens",
                "github.vscode-pull-request-github",
                "ionutvmi.path-autocomplete",
                "jrebocho.vscode-random",
                "njpwerner.autodocstring",
                "marp-team.marp-vscode",
                "mechatroner.rainbow-csv",
                "ms-python.mypy-type-checker",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers",
                "shardulm94.trailing-spaces",
                "streetsidesoftware.code-spell-checker",
                "usernamehw.errorlens"
            ]
        }
    }
}
EOF

echo "  docker-compose.yml"
cat > .devcontainer/docker-compose.yml <<'EOF'
services:
  dev:
    build: .
    stdin_open: true
    working_dir: "/tmp/work"
    volumes:
      - ..:/tmp/work
EOF

echo "  Dockerfile"
cat > .devcontainer/Dockerfile <<'EOF'
FROM python:3.13

# create non-root user
RUN groupadd -r docker \
    && useradd -r -g docker -s /bin/bash -m docker

# Install required packages.
# Note: chromium is only needed to render PDFs with marp. Drop it if you do
#       not use marp; it is by far the largest part of this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    git \
    make \
    chromium \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/work

COPY requirements.txt ./

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

ENV PYTHONPATH=/tmp/work/mylib

USER docker
EOF

echo "  requirements.txt"
cat > .devcontainer/requirements.txt <<'EOF'
# ruff replaces black, flake8, isort, pylint and yapf.
ruff
mypy
pytest
pytest-cov
matplotlib
numpy
pandas
rich
tabulate
tqdm
EOF

echo "finished!"
